# Αντίγραψε σε .env και συμπλήρωσε. ΜΗΝ κάνεις commit το .env.

# CourtListener API token (προφίλ → API token). ΞΑΝΑ-ΕΚΔΩΣΕ το παλιό που είχε διαρρεύσει.
CL_API_TOKEN=

